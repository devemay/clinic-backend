# Copy file này thành .env và điền thông tin thật (không đưa file .env thật lên GitHub công khai)

# MySQL — để trống nếu chưa có, hệ thống sẽ tự dùng SQLite tại chỗ để chạy thử
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=clinic

# AWS S3 — để trống nếu chưa có, ảnh sẽ tạm lưu trong thư mục uploads/ để chạy thử
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
S3_BUCKET=

# --- Tài khoản AWS PHỤ, chỉ dùng để chứa backup — tạo bằng email khác, tách biệt hoàn toàn tài khoản chính ---
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
BACKUP_AWS_REGION=ap-southeast-1
BACKUP_S3_BUCKET=

# Đổi sang một chuỗi ngẫu nhiên dài trước khi dùng thật
CLINIC_SECRET_KEY=change-this-secret-in-production
